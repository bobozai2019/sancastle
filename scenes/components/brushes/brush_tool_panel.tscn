icon_alignment = 1
vertical_icon_alignment = 0
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_font_sizes/font_size = 13

[node name="GravelDrop" type="Button" parent="Margin/Controls/Tools"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(68, 78)
focus_mode = 0
toggle_mode = true
button_group = SubResource("Tools")
text = "投碎石"
tooltip_text = "在指定沙地或水中投放碎石，随水流搬运；不会挤掉已有碎石"
icon = ExtResource("icon_GravelDrop")
icon_alignment = 1
vertical_icon_alignment = 0
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_font_sizes/font_size = 13

[node name="GravelParams" type="VBoxContainer" parent="Margin/Controls"]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="AmountLabel" type="Label" parent="Margin/Controls/GravelParams"]
layout_mode = 2
text = "碎石数量 · 颗 / 次"

[node name="GravelCount" type="SpinBox" parent="Margin/Controls/GravelParams"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1.0
max_value = 128.0
step = 1.0
value = 16.0
suffix = "颗"

[node name="OrdinaryParams" type="VBoxContainer" parent="Margin/Controls"]

unique_name_in_owner = true

layout_mode = 2

[node name="DigAmountLabel" type="Label" parent="Margin/Controls/OrdinaryParams"]

layout_mode = 2

text = "挖沙量 · m³ / 次"

[node name="DigAmount" type="SpinBox" parent="Margin/Controls/OrdinaryParams"]

