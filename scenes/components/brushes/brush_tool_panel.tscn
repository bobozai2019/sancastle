[connection signal="pressed" from="Margin/Controls/Tools/Dig" to="." method="_on_tool_pressed" binds= [ &"remove_sand" ]]

[connection signal="pressed" from="Margin/Controls/Tools/Fill" to="." method="_on_tool_pressed" binds= [ &"place_sand" ]]

[connection signal="pressed" from="Margin/Controls/Tools/SuspendedSand" to="." method="_on_tool_pressed" binds= [ &"suspended_sand" ]]

[connection signal="pressed" from="Margin/Controls/Tools/GravelDrop" to="." method="_on_tool_pressed" binds= [ &"gravel_drop" ]]
[connection signal="value_changed" from="Margin/Controls/GravelParams/GravelCount" to="." method="_on_value_changed"]

[connection signal="pressed" from="Margin/Controls/Tools/Castle" to="." method="_on_tool_pressed" binds= [ &"castle_v1" ]]

[connection signal="pressed" from="Margin/Controls/Tools/Shovel" to="." method="_on_tool_pressed" binds= [ &"shovel_v1" ]]

[connection signal="pressed" from="Margin/Controls/Tools/Wall" to="." method="_on_tool_pressed" binds= [ &"wall_v1" ]]

[connection signal="value_changed" from="Margin/Controls/OrdinaryParams/DigAmount" to="." method="_on_value_changed"]

