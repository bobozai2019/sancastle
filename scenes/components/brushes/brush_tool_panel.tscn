[ext_resource type="Script" path="res://scripts/sand/brushes/brush_tool_panel.gd" id="1"]

[sub_resource type="ButtonGroup" id="Tools"]

[sub_resource type="StyleBoxFlat" id="Panel"]

bg_color = Color(0.06, 0.09, 0.12, 0.94)

corner_radius_top_left = 10

corner_radius_top_right = 10

corner_radius_bottom_left = 10

corner_radius_bottom_right = 10

[node name="ShapeBrushPanel" type="PanelContainer"]

custom_minimum_size = Vector2(712, 0)

script = ExtResource("1")

theme = ExtResource("beach_theme")
anchor_left = 0.5
anchor_right = 0.5
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = -356.0
offset_right = 356.0
offset_top = -188.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="."]

layout_mode = 2

theme_override_constants/margin_left = 14

theme_override_constants/margin_right = 14

theme_override_constants/margin_top = 12

theme_override_constants/margin_bottom = 12

[node name="Controls" type="VBoxContainer" parent="Margin"]

layout_mode = 2

theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Margin/Controls"]

layout_mode = 2

text = "沙滩工具"

theme_override_font_sizes/font_size = 16

[node name="Tools" type="GridContainer" parent="Margin/Controls"]

layout_mode = 2

columns = 9

[node name="Dig" type="Button" parent="Margin/Controls/Tools"]

unique_name_in_owner = true

layout_mode = 2

size_flags_horizontal = 3

custom_minimum_size = Vector2(68, 78)

focus_mode = 0

toggle_mode = true

button_group = SubResource("Tools")

text = "挖沙"

button_pressed = true
icon = ExtResource("icon_Dig")
icon_alignment = 1
vertical_icon_alignment = 0
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_font_sizes/font_size = 13

[node name="Fill" type="Button" parent="Margin/Controls/Tools"]

unique_name_in_owner = true

layout_mode = 2

size_flags_horizontal = 3

custom_minimum_size = Vector2(68, 78)

focus_mode = 0

toggle_mode = true

button_group = SubResource("Tools")

text = "填沙床"
tooltip_text = "直接填高沙床；可在水下使用"
icon = ExtResource("icon_Fill")
icon_alignment = 1
vertical_icon_alignment = 0
expand_icon = true
theme_override_constants/icon_max_width = 42
theme_override_font_sizes/font_size = 13

[node name="Castle" type="Button" parent="Margin/Controls/Tools"]

