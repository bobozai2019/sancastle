unique_name_in_owner = true

layout_mode = 2

min_value = 0.5

max_value = 1

step = 0.05

value = 0.7

suffix = "m"

[node name="CastleYawLabel" type="Label" parent="Margin/Controls/CastleParams"]

layout_mode = 2

