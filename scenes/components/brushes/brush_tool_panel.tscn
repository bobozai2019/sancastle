[connection signal="value_changed" from="Margin/Controls/CastleParams/CastleHeight" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/CastleParams/CastleYaw" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/WallParams/WallHeight" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/WallParams/WallBottom" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/WallParams/WallTop" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/ShovelParams/ShovelWidth" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/ShovelParams/ShovelDepth" to="." method="_on_value_changed"]

[connection signal="value_changed" from="Margin/Controls/ShovelParams/ShovelShoulder" to="." method="_on_value_changed"]
