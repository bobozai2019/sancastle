layout_mode = 2

min_value = 0.01

max_value = 1

step = 0.01

value = 0.1

suffix = "m³"

[node name="FillAmountLabel" type="Label" parent="Margin/Controls/OrdinaryParams"]

layout_mode = 2

text = "投沙量 · m³ / 次"

[node name="FillAmount" type="SpinBox" parent="Margin/Controls/OrdinaryParams"]

