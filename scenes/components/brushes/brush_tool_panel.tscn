[node name="SuspendedSand" type="Button" parent="Margin/Controls/Tools"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(68, 78)
focus_mode = 0
toggle_mode = true
button_group = SubResource("Tools")
text = "投流沙"
tooltip_text = "投放随水流输运的悬沙，之后自然沉降；不直接抬高沙床"
