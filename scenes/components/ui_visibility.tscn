[ext_resource type="Script" path="res://scripts/beach/ui_visibility.gd" id="1"]

[node name="UIVisibility" type="CanvasLayer"]
layer = 10
script = ExtResource("1")

[node name="ToggleUI" type="Button" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -126.0
offset_top = 12.0
offset_right = -18.0
offset_bottom = 48.0
grow_horizontal = 0
focus_mode = 0
toggle_mode = true
text = "隐藏 UI"
tooltip_text = "显示 / 隐藏全部面板（F6）；隐藏后仍可编辑沙子"
theme = ExtResource("beach_theme")

[connection signal="pressed" from="ToggleUI" to="." method="_on_toggle_pressed"]
