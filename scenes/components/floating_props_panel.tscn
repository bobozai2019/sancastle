corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[node name="FloatingPropsPanel" type="PanelContainer"]
offset_left = 18.0
offset_top = 100.0
offset_right = 322.0
offset_bottom = 400.0
theme = ExtResource("beach_theme")
script = ExtResource("1")
[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10
[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 7
[node name="Title" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "海边拾趣"
theme_override_font_sizes/font_size = 18
[node name="Description" type="Label" parent="Margin/Rows"]
layout_mode = 2
text = "每类 1 件 · 选择槽位投放或移动"
theme_override_font_sizes/font_size = 13
[node name="Slots" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 6
[node name="Slot1" type="Button" parent="Margin/Rows/Slots"]
custom_minimum_size = Vector2(86, 94)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
toggle_mode = true
text = "水瓶\n已摆放"
icon = ExtResource("icon_bottle")
icon_alignment = 1
vertical_icon_alignment = 0
expand_icon = true
